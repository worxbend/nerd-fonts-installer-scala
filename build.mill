//| mill-version: 1.1.7
//| mvnDeps: ["com.goyeau::mill-scalafix::0.6.2"]
package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import mill.api.ModuleRef
import mill.javalib.JvmWorkerModule
import mill.javalib.NativeImageModule
import mill.scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule

object Versions:
  val project = "0.1.0"
  val scala   = "3.8.4"
  // GraalVM Community for JDK 25 ships `native-image`, so one toolchain compiles, tests and links the
  // binary on every CI runner without a separate GraalVM setup step.
  val graalvm        = "graalvm-community:25.0.1"
  val ox             = "1.0.6"
  val osLib          = "0.11.8"
  val fansi          = "0.5.1"
  val upickle        = "4.4.3"
  val scalaYaml      = "0.3.3"
  val picocli        = "4.7.7"
  val munit          = "1.3.6"
  val munitScalacheck = "1.3.1"

object Deps:
  val ox              = mvn"com.softwaremill.ox::core:${Versions.ox}"
  val osLib           = mvn"com.lihaoyi::os-lib:${Versions.osLib}"
  val fansi           = mvn"com.lihaoyi::fansi:${Versions.fansi}"
  val upickle         = mvn"com.lihaoyi::upickle:${Versions.upickle}"
  val scalaYaml       = mvn"org.virtuslab::scala-yaml:${Versions.scalaYaml}"
  val picocli         = mvn"info.picocli:picocli:${Versions.picocli}"
  val munit           = mvn"org.scalameta::munit:${Versions.munit}"
  val munitScalacheck = mvn"org.scalameta::munit-scalacheck:${Versions.munitScalacheck}"

/** One JVM for everything: compiling, testing and `native-image`. */
object GraalvmWorker extends JvmWorkerModule:
  def jvmVersion = Versions.graalvm

trait NerdFontsModule extends ScalaModule, ScalafmtModule, ScalafixModule:
  def scalaVersion = Versions.scala
  def jvmWorker    = ModuleRef(GraalvmWorker)
  // `javaHome` derives from this, and NativeImageModule locates `native-image` inside it.
  def jvmVersion   = Versions.graalvm

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Werror",
    "-Wsafe-init",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-source:future",
  )

  def forkArgs = Seq(s"-Dnerdfonts.repoRoot=${mill.api.BuildCtx.workspaceRoot}")

  trait NerdFontsTests extends ScalaTests, ScalafmtModule, ScalafixModule:
    def mvnDeps       = Seq(Deps.munit, Deps.munitScalacheck)
    def testFramework = "munit.Framework"
    def forkArgs      = Seq(s"-Dnerdfonts.repoRoot=${mill.api.BuildCtx.workspaceRoot}")

/** Domain, ports and the install engine. No CLI or terminal code. */
object core extends NerdFontsModule:
  def mvnDeps = Seq(Deps.ox, Deps.osLib, Deps.upickle)
  object test extends NerdFontsTests

/** Config file decoding (YAML / JSON) and discovery. */
object config extends NerdFontsModule:
  def moduleDeps = Seq(core)
  def mvnDeps    = Seq(Deps.scalaYaml, Deps.upickle)
  object test extends NerdFontsTests

/** The interactive terminal picker: a pure model plus a thin terminal adapter. */
object picker extends NerdFontsModule:
  def moduleDeps = Seq(core)
  def mvnDeps    = Seq(Deps.fansi, Deps.ox)
  // The picker tests script `stty` through core's `FakeProcessRunner`.
  object test extends NerdFontsTests:
    def moduleDeps = super.moduleDeps ++ Seq(core.test)

/** Picocli command surface, exit codes and application wiring. */
object cli extends NerdFontsModule:
  def moduleDeps = Seq(core, config, picker)
  def mvnDeps    = Seq(Deps.picocli, Deps.fansi)

  def generatedSources = Task:
    super.generatedSources() ++ Seq(buildInfoSources())

  // `Task.Input`, not a cached `Task`: the commit and the date live outside the build graph, and a cached task
  // would pin whichever values it saw first.
  def gitCommit = Task.Input:
    val result = os
      .proc("git", "rev-parse", "--short=12", "HEAD")
      .call(cwd = mill.api.BuildCtx.workspaceRoot, check = false, stderr = os.Pipe)
    val sha = result.out.trim()
    if result.exitCode == 0 && sha.nonEmpty then sha else "unknown"

  def buildDate = Task.Input:
    Task.env.getOrElse("NERD_FONTS_INSTALLER_BUILD_DATE", "unknown")

  def buildInfoSources = Task:
    val out = Task.dest / "io" / "worxbend" / "nerdfonts" / "cli" / "BuildInfo.scala"
    os.write.over(
      out,
      s"""package io.worxbend.nerdfonts.cli
         |
         |/** Build-time constants generated by `build.mill`; do not edit by hand. */
         |object BuildInfo:
         |  val version: String = "${Versions.project}"
         |  val commit: String = "${gitCommit()}"
         |  val buildDate: String = "${buildDate()}"
         |""".stripMargin,
      createFolders = true,
    )
    PathRef(Task.dest)

  object test extends NerdFontsTests

/** Process entry point and the GraalVM native image. */
object app extends NerdFontsModule, NativeImageModule:
  def moduleDeps = Seq(cli)
  def mainClass  = Some("io.worxbend.nerdfonts.app.Main")

  def nativeImageOptions = Seq(
    "--no-fallback",
    "-O2",
    // GraalVM 25's AMD64 default is `x86-64-v3` (AVX2/BMI2), which aborts at startup on a pre-2013 CPU or a
    // default-model VM/container; `compatibility` is native-image's baseline-features setting on every
    // architecture (already AArch64's default, so arm64 builds are unaffected) and matches the Go reference's
    // `GOAMD64=v1`.
    "-march=compatibility",
    "--initialize-at-build-time=scala",
    "-H:+ReportExceptionStackTraces",
    // `sun.misc.Unsafe` reads its memory-access policy once, from the VM's saved startup properties, into a
    // `static final`; the class initialises inside the image builder, so the binary carries the builder JVM's
    // value. Without this the shipped binary prints JDK 25's four-line `WARNING: sun.misc.Unsafe` banner
    // (triggered by `scala.runtime.LazyVals$`) to stderr on every run.
    "-J-Dsun.misc.unsafe.memory.access=allow",
  )

  def writeAssembly(dest: String = "dist/nerd-fonts-installer.jar") = Task.Command:
    val out = os.Path(dest, mill.api.BuildCtx.workspaceRoot)
    os.makeDir.all(out / os.up)
    os.copy.over(assembly().path, out, createFolders = true)
    println(out)

  object test extends NerdFontsTests
