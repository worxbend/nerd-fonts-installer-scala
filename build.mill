//| mill-version: 1.1.9
//| mvnDeps: ["com.goyeau::mill-scalafix::0.6.2"]
package build

import com.goyeau.mill.scalafix.ScalafixModule
import mill.*
import mill.api.ModuleRef
import mill.javalib.JvmWorkerModule
import mill.javalib.NativeImageModule
import mill.scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule

object Versions:
  val project = "0.1.0"
  val scala   = "3.9.0"
  // GraalVM Community for JDK 25 ships `native-image`, so one toolchain compiles, tests and links the
  // binary on every CI runner without a separate GraalVM setup step.
  val graalvm   = "graalvm-community:25.0.2"
  val zio       = "2.1.26"
  val zioConfig = "4.1.0"
  val zioHttp   = "3.11.5"
  val zioJson   = "1.1.0"
  val osLib     = "0.11.8"
  val fansi     = "0.5.1"

object Deps:
  // Scala 3.8 renamed the standard library artifact from `scala3-library_3` to `scala-library`. Some ZIO
  // artifacts still declare the old coordinate, which would otherwise put a second, older copy of the Scala
  // library on the test classpath, shadowing the one we compiled against.
  private val staleScalaLibrary = ("org.scala-lang", "scala3-library_3")

  val zio        = mvn"dev.zio::zio:${Versions.zio}"
  val zioStreams = mvn"dev.zio::zio-streams:${Versions.zio}"
  val zioJson    = mvn"dev.zio::zio-json:${Versions.zioJson}"
  val zioHttp    = mvn"dev.zio::zio-http:${Versions.zioHttp}"
  val zioConfig  = mvn"dev.zio::zio-config:${Versions.zioConfig}"
  // YAML has its own provider; HOCON *and* JSON both go through Typesafe Config, because HOCON is a
  // superset of JSON. See `ConfigFormat` for the extension mapping.
  val zioConfigYaml     = mvn"dev.zio::zio-config-yaml:${Versions.zioConfig}"
  val zioConfigTypesafe = mvn"dev.zio::zio-config-typesafe:${Versions.zioConfig}"
  val zioConfigMagnolia = mvn"dev.zio::zio-config-magnolia:${Versions.zioConfig}"
  val osLib             = mvn"com.lihaoyi::os-lib:${Versions.osLib}"
  val fansi             = mvn"com.lihaoyi::fansi:${Versions.fansi}"
  val zioTest         = mvn"dev.zio::zio-test:${Versions.zio}".exclude(staleScalaLibrary)
  val zioTestSbt      = mvn"dev.zio::zio-test-sbt:${Versions.zio}".exclude(staleScalaLibrary)
  val zioTestMagnolia = mvn"dev.zio::zio-test-magnolia:${Versions.zio}".exclude(staleScalaLibrary)

/** One JVM for everything: compiling, testing and `native-image`. */
object GraalvmWorker extends JvmWorkerModule:
  def jvmVersion = Versions.graalvm

trait NerdFontsModule extends ScalaModule, ScalafmtModule, ScalafixModule:
  def scalaVersion = Versions.scala
  def jvmWorker    = ModuleRef(GraalvmWorker)
  // `javaHome` derives from this, and NativeImageModule locates `native-image` inside it.
  def jvmVersion   = Versions.graalvm

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Werror",
    "-Wsafe-init",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-source:future",
  )

  def forkArgs = Seq(s"-Dnerdfonts.repoRoot=${mill.api.BuildCtx.workspaceRoot}")

  trait NerdFontsTests extends ScalaTests, ScalafmtModule, ScalafixModule:
    def mvnDeps       = Seq(Deps.zioTest, Deps.zioTestSbt, Deps.zioTestMagnolia)
    def testFramework = "zio.test.sbt.ZTestFramework"
    def forkArgs      = Seq(s"-Dnerdfonts.repoRoot=${mill.api.BuildCtx.workspaceRoot}")

/** Domain, ports and the install engine. No CLI or terminal code. */
object core extends NerdFontsModule:
  def mvnDeps = Seq(Deps.zio, Deps.zioStreams, Deps.zioJson, Deps.zioHttp, Deps.osLib)
  object test extends NerdFontsTests

/** Config file decoding (YAML / HOCON / JSON) and discovery. */
object config extends NerdFontsModule:
  def moduleDeps = Seq(core)
  def mvnDeps    = Seq(Deps.zioConfig, Deps.zioConfigYaml, Deps.zioConfigTypesafe, Deps.zioConfigMagnolia)
  object test extends NerdFontsTests

/** Argument parsing, exit codes and application wiring. */
object cli extends NerdFontsModule:
  def moduleDeps = Seq(core, config)
  def mvnDeps    = Seq(Deps.fansi)

  def generatedSources = Task:
    super.generatedSources() ++ Seq(buildInfoSources())

  // `Task.Input`, not a cached `Task`: the commit and the date live outside the build graph, and a cached task
  // would pin whichever values it saw first.
  def gitCommit = Task.Input:
    val result = os
      .proc("git", "rev-parse", "--short=12", "HEAD")
      .call(cwd = mill.api.BuildCtx.workspaceRoot, check = false, stderr = os.Pipe)
    val sha = result.out.trim()
    if result.exitCode == 0 && sha.nonEmpty then sha else "unknown"

  def buildDate = Task.Input:
    Task.env.getOrElse("NERD_FONTS_INSTALLER_BUILD_DATE", "unknown")

  def buildInfoSources = Task:
    val out = Task.dest / "io" / "worxbend" / "nerdfonts" / "cli" / "BuildInfo.scala"
    os.write.over(
      out,
      s"""package io.worxbend.nerdfonts.cli
         |
         |/** Build-time constants generated by `build.mill`; do not edit by hand. */
         |object BuildInfo:
         |  val version: String = "${Versions.project}"
         |  val commit: String = "${gitCommit()}"
         |  val buildDate: String = "${buildDate()}"
         |""".stripMargin,
      createFolders = true,
    )
    PathRef(Task.dest)

  object test extends NerdFontsTests

/** Process entry point and the GraalVM native image. */
object app extends NerdFontsModule, NativeImageModule:
  def moduleDeps = Seq(cli)
  def mainClass  = Some("io.worxbend.nerdfonts.app.Main")

  def nativeImageOptions = Seq(
    "--no-fallback",
    "-O2",
    // GraalVM 25's AMD64 default is `x86-64-v3` (AVX2/BMI2), which aborts at startup on a pre-2013 CPU or a
    // default-model VM/container; `compatibility` is native-image's baseline-features setting on every
    // architecture (already AArch64's default, so arm64 builds are unaffected) and matches the Go reference's
    // `GOAMD64=v1`.
    "-march=compatibility",
    "--initialize-at-build-time=scala",
    // zio-http runs on Netty, which must not be initialised into the image heap.
    "--initialize-at-run-time=io.netty",
    // Netty 4.2's `AdaptivePoolingAllocator` allocates through `java.lang.foreign.Arena.ofShared`, which
    // native-image gates off by default. Without this flag the binary links successfully, serves the request
    // correctly, prints the right answer -- and then *never exits*: `UnsupportedFeatureError: Support for
    // Arena.ofShared is not active` is thrown on every event-loop thread during Netty's shutdown path
    // (`FastThreadLocal.removeAll` -> `AdaptivePoolingAllocator.onRemoval` -> `ArenaImpl.close`). The fiber
    // never sees an error, so nothing can catch it. Two consequences, both measured:
    //   * a CI check that greps stdout PASSES on a broken binary -- it must assert the exit code instead;
    //   * the hung process ignores SIGTERM, so any timeout guarding it has to escalate to SIGKILL.
    // Setting `-Dio.netty.allocator.type` here does not help: build-time `-D` configures the image builder,
    // not the resulting binary. See scripts/ci/native-network-smoke.sh, which is the gate for this.
    "-H:+SharedArenaSupport",
    "-H:+ReportExceptionStackTraces",
    // `sun.misc.Unsafe` reads its memory-access policy once, from the VM's saved startup properties, into a
    // `static final`; the class initialises inside the image builder, so the binary carries the builder JVM's
    // value. Without this the shipped binary prints JDK 25's four-line `WARNING: sun.misc.Unsafe` banner
    // (triggered by `scala.runtime.LazyVals$`) to stderr on every run.
    "-J-Dsun.misc.unsafe.memory.access=allow",
  )

  def writeAssembly(dest: String = "dist/nerd-fonts-installer.jar") = Task.Command:
    val out = os.Path(dest, mill.api.BuildCtx.workspaceRoot)
    os.makeDir.all(out / os.up)
    os.copy.over(assembly().path, out, createFolders = true)
    println(out)

  object test extends NerdFontsTests
